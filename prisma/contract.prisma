// use prisma-8

type Achievement {
  title       String
  description String
  metric      String
}

model Case {
  slug             String @id
  name             String
  projectLink      String @map("project_link")
  category         String
  stack            String[]
  shortDescription String @map("short_description")
  description      String
  imageKey         String? @map("image_key")
  blurImage        String? @map("blur_image")
  role             pg.enum(Role)
  achievements     Achievement[]
  company          String?
  teamSize         Int? @map("team_size")
  startedAt        DateString @map("started_at")
  endedAt          DateString? @map("ended_at")
  sortOrder        Int @default(0) @map("sort_order")
  published        Boolean @default(false)
  createdAt        TimestamptzJsDate @default(now()) @map("created_at")
  updatedAt        temporal.updatedAtJsDate() @map("updated_at")

  @@map("cases")
}

native_enum Role {
  FRONTEND = "FRONTEND"
  FULLSTACK = "FULLSTACK"
}
