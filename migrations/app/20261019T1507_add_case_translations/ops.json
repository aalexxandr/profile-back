  {
    "id": "table.case_translations",
    "label": "Create table \"case_translations\"",
    "summary": "Creates table \"case_translations\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "case_translations"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"case_translations\" does not exist",
        "sql": "SELECT (to_regclass($1)) IS NULL AS \"result\"",
        "params": [
          "\"public\".\"case_translations\""
        ]
      }
    ],
    "execute": [
      {
        "description": "create table \"case_translations\"",
        "sql": "CREATE TABLE \"public\".\"case_translations\" (\n  \"achievements\" jsonb NOT NULL,\n  \"case_slug\" text NOT NULL,\n  \"category\" text NOT NULL,\n  \"description\" text NOT NULL,\n  \"locale\" \"Locale\" NOT NULL,\n  \"name\" text NOT NULL,\n  \"short_description\" text NOT NULL,\n  PRIMARY KEY (\"case_slug\", \"locale\")\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"case_translations\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"case_translations\""
        ]
      }
    ]
  },
