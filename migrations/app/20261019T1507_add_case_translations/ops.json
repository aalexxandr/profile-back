  {
    "id": "foreignKey.case_translations.case_translations_case_slug_fkey",
    "label": "Add foreign key \"case_translations_case_slug_fkey\" on \"case_translations\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "foreignKey",
        "name": "case_translations_case_slug_fkey",
        "table": "case_translations"
      }
    },
    "precheck": [
      {
        "description": "ensure FK \"case_translations_case_slug_fkey\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "case_translations_case_slug_fkey",
          "public",
          "\"public\".\"case_translations\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add FK \"case_translations_case_slug_fkey\"",
        "sql": "ALTER TABLE \"public\".\"case_translations\"\nADD CONSTRAINT \"case_translations_case_slug_fkey\"\nFOREIGN KEY (\"case_slug\")\nREFERENCES \"public\".\"cases\" (\"slug\")\nON DELETE CASCADE"
      }
    ],
    "postcheck": [
      {
        "description": "verify FK \"case_translations_case_slug_fkey\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "case_translations_case_slug_fkey",
          "public",
          "\"public\".\"case_translations\""
        ]
      }
    ]
  },
  {
    "id": "data.case_translations.copy_ru",
    "label": "Copy the text of every case into a \"ru\" translation",
    "operationClass": "data",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "case_translations"
      }
    },
    "precheck": [
      {
        "description": "ensure the old text columns still exist on \"cases\"",
        "sql": "SELECT EXISTS (SELECT 1 FROM \"information_schema\".\"columns\" WHERE \"table_schema\" = 'public' AND \"table_name\" = 'cases' AND \"column_name\" = 'name') AS \"result\""
      }
    ],
    "execute": [
      {
        "description": "insert one \"ru\" translation per case",
        "sql": "INSERT INTO \"public\".\"case_translations\" (\"case_slug\", \"locale\", \"name\", \"category\", \"short_description\", \"description\", \"achievements\") SELECT \"slug\", 'ru'::\"public\".\"Locale\", \"name\", \"category\", \"short_description\", \"description\", \"achievements\" FROM \"public\".\"cases\""
      }
    ],
    "postcheck": [
      {
        "description": "verify every case has a \"ru\" translation",
        "sql": "SELECT NOT EXISTS (SELECT 1 FROM \"public\".\"cases\" c WHERE NOT EXISTS (SELECT 1 FROM \"public\".\"case_translations\" t WHERE t.\"case_slug\" = c.\"slug\" AND t.\"locale\" = 'ru'::\"public\".\"Locale\")) AS \"result\""
      }
    ]
  },
  {
    "id": "data.cases.unpublish_all",
    "label": "Unpublish every case until its \"en\" translation is added",
    "operationClass": "data",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "cases"
      }
    },
    "precheck": [],
    "execute": [
      {
        "description": "set published = false on all cases",
        "sql": "UPDATE \"public\".\"cases\" SET \"published\" = false WHERE \"published\" = true"
      }
    ],
    "postcheck": [
      {
        "description": "verify no case is published",
        "sql": "SELECT NOT EXISTS (SELECT 1 FROM \"public\".\"cases\" WHERE \"published\" = true) AS \"result\""
      }
    ]
  },
