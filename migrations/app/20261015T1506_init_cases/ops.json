    "execute": [
      {
        "description": "create table \"cases\"",
        "sql": "CREATE TABLE \"public\".\"cases\" (\n  \"achievements\" jsonb NOT NULL,\n  \"category\" text NOT NULL,\n  \"company\" text,\n  \"created_at\" timestamptz DEFAULT (now()) NOT NULL,\n  \"description\" text NOT NULL,\n  \"ended_at\" date,\n  \"name\" text NOT NULL,\n  \"project_link\" text NOT NULL,\n  \"published\" bool DEFAULT false NOT NULL,\n  \"role\" \"Role\" NOT NULL,\n  \"short_description\" text NOT NULL,\n  \"slug\" text NOT NULL,\n  \"sort_order\" int4 DEFAULT 0 NOT NULL,\n  \"stack\" text[] NOT NULL,\n  \"started_at\" date NOT NULL,\n  \"team_size\" int4,\n  \"updated_at\" timestamptz NOT NULL,\n  PRIMARY KEY (\"slug\"),\n  CONSTRAINT \"cases_stack_elem_not_null_e2a6c8b5\" CHECK (array_position(\"stack\", NULL) IS NULL)\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"cases\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
