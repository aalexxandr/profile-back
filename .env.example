# Копия для локальной разработки: cp .env.example .env
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio

# Читают приложение (ConfigService) и Prisma CLI (prisma.config.ts)
POSTGRES_URI=postgresql://postgres:change-me@localhost:5434/portfolio

# Необязательно, по умолчанию 3000
# PORT=3000
