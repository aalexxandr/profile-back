# Копия для локальной разработки: cp .env.example .env
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio

# Читают приложение (ConfigService) и Prisma CLI (prisma.config.ts)
POSTGRES_URI=postgresql://postgres:change-me@localhost:5434/portfolio

# Необязательно, по умолчанию 3000
# PORT=3000

# S3-хранилище картинок (Selectel, бакет portfolio). Все шесть обязательны:
# без любой из них приложение не запустится
S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru
S3_REGION=ru-1
S3_BUCKET=portfolio
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
# Публичный адрес бакета; к нему добавляется ключ объекта (cases/<slug>/<хеш>.webp)
S3_PUBLIC_URL=https://change-me.example.com

# Токен администратора для запросов на запись (Authorization: Bearer <токен>).
# Обязателен, не короче 32 символов, иначе приложение не запустится.
# Сгенерировать: openssl rand -hex 32
ADMIN_TOKEN=change-me
